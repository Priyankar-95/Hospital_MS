# Copy this file to .env and fill in the blanks. Never commit .env.

APP_ENV=local
APP_DEBUG=true
APP_NAME="Liberty Health Care"
# Base URL of the site, no trailing slash
APP_URL=http://localhost:8100

# Database (XAMPP MySQL/MariaDB on this machine listens on 3307)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=hospital_booking
DB_USER=root
DB_PASS=

# Session / security
SESSION_NAME=hb_session
SESSION_LIFETIME_MINUTES=120
# Set to true only when the site is served over HTTPS
SESSION_SECURE_COOKIE=false

# Google OAuth2 (console.cloud.google.com > APIs & Services > Credentials > OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" in the Google console
GOOGLE_REDIRECT_URI=http://localhost:8100/api/auth/google-callback

# Razorpay (test mode keys start with rzp_test_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMTP email
SMTP_HOST=
SMTP_PORT=587
# tls (STARTTLS, port 587), ssl (port 465) or none
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Liberty Health Care"

# Uploads
UPLOAD_MAX_MB=5

# Testing relaxations (see docs/RELAXED_FOR_TESTING.md). Set to true before going live.
REQUIRE_VERIFICATION_DOCUMENTS=false
